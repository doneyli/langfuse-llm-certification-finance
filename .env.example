# === Langfuse — required ===
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Uncomment exactly ONE LANGFUSE_BASE_URL. See README "Choose your Langfuse
# deployment" for the trade-offs between Cloud and self-hosted.
LANGFUSE_BASE_URL=https://cloud.langfuse.com       # Langfuse Cloud (EU)
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com  # Langfuse Cloud (US)
# LANGFUSE_BASE_URL=http://localhost:3000          # Self-hosted (see selfhost/README.md)

# === LLM provider — set one of the following depending on your model ===
# For Anthropic/Claude models
ANTHROPIC_API_KEY=sk-ant-...
# For OpenAI-compatible models or custom gateways
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1

# Optional overrides (defaults shown)
# LLM_MODEL=claude-sonnet-4-6
# JUDGE_MODEL=claude-sonnet-4-6
# CERT_MODEL=claude-haiku-4-5-20251001
# CERT_THRESHOLD=0.85
# PORTAL_PORT=8050
